<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title }) %></head>
<body>
<%- include('partials/portal-nav') %>
  <h1>Edit User</h1>
  <p><a href="/portal/members">&larr; Users &amp; Roles</a><% if (can('employees.view')) { %> &middot; <a href="/manage/employees/<%= editMember.id %>">Employee record</a><% } %></p>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <form method="POST" action="/portal/members/<%= editMember.id %>/edit" class="form-grid card">
    <label>Name <input type="text" name="name" value="<%= editMember.name %>" required /></label>
    <label>Email <input type="email" name="email" value="<%= editMember.email %>" required /></label>
    <label>Phone <input type="tel" name="phone" value="<%= editMember.phone || '' %>" /></label>
    <label>Role
      <select name="role" <%= isSelf ? 'disabled' : '' %>>
        <% roles.forEach(function(r) { %>
          <option value="<%= r.key %>" <%= editMember.role === r.key ? 'selected' : '' %>><%= r.name %></option>
        <% }); %>
      </select>
    </label>
    <label>Status
      <select name="active" <%= isSelf ? 'disabled' : '' %>>
        <option value="1" <%= editMember.active ? 'selected' : '' %>>Active</option>
        <option value="0" <%= !editMember.active ? 'selected' : '' %>>Deactivated</option>
      </select>
    </label>
    <label>New password <input type="password" name="password" minlength="8" autocomplete="new-password" placeholder="Leave blank to keep current" /></label>
    <p class="full hint">Last login: <%= fmt.dt(editMember.last_login_at) || 'never' %><% if (editMember.locked_until) { %> &middot; locked until <%= fmt.dt(editMember.locked_until) %> (setting a new password unlocks)<% } %></p>
    <% if (editMember.mfa_enabled && !isSelf) { %><label class="full" style="flex-direction:row; align-items:center; gap:0.4rem; font-weight:400;"><input type="checkbox" name="reset_mfa" value="1" style="width:auto;" /> Reset two-step verification (lost phone)</label><% } %>
    <% if (isSelf) { %><p class="full">You can't change your own role or deactivate your own account.</p><% } %>
    <div class="full"><button type="submit" class="primary-btn">Save Changes</button></div>
  </form>
<%- include('partials/footer') %>
</body>
</html>
