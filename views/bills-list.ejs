<%- include('partials/page-start') %>
<div class="page-header"><div><h1>Vendor Bills (Accounts Payable)</h1></div><div class="btn-row"><a class="btn btn-secondary" href="/vendors">Vendors</a><% if (can('purchasing.manage')) { %><a class="btn btn-secondary" href="/purchasing">Purchase orders</a><% } %></div></div>
<div class="stat-grid">
  <div class="stat"><div class="stat-label">Total owed</div><div class="stat-value"><%= fmt.money(aging.total) %></div></div>
  <div class="stat good"><div class="stat-label">Not yet due</div><div class="stat-value"><%= fmt.money(aging.buckets.current) %></div></div>
  <div class="stat warn"><div class="stat-label">1-30 days late</div><div class="stat-value"><%= fmt.money(aging.buckets.d1_30) %></div></div>
  <div class="stat bad"><div class="stat-label">31+ days late</div><div class="stat-value"><%= fmt.money(aging.buckets.d31_60 + aging.buckets.d61_90 + aging.buckets.d90_plus) %></div></div>
</div>
<details class="card" style="margin-bottom:1rem;"><summary><strong>+ Enter a bill without a purchase order</strong> <span class="hint">(rent, utilities, subcontractors, insurance...)</span></summary>
  <% if (!vendors.length) { %><p class="empty">Add a vendor first.</p><% } else { %>
  <form method="POST" action="/bills/new" enctype="multipart/form-data" class="stack-form mt">
    <div class="inline-fields">
      <label>Vendor <select name="vendor_id"><% vendors.forEach(function(v) { %><option value="<%= v.id %>"><%= v.name %></option><% }); %></select></label>
      <label>Vendor's invoice # <input name="bill_number" /></label>
      <label>Bill date <input type="date" name="bill_date" value="<%= today %>" /></label>
      <label>Due <input type="date" name="due_date" /></label>
    </div>
    <table class="data-table"><thead><tr><th>Account</th><th>Description</th><th class="num">Amount</th></tr></thead><tbody>
      <% for (var i = 0; i < 3; i++) { %><tr><td><select name="account_id"><option value="">-</option><% accounts.forEach(function(a) { %><option value="<%= a.id %>"><%= a.code %> <%= a.name %></option><% }); %></select></td><td><input name="line_description" /></td><td><input name="amount" inputmode="decimal" /></td></tr><% } %>
    </tbody></table>
    <label>Memo <input name="memo" /></label>
    <label>Scan / PDF <input type="file" name="attachment" accept="image/*,application/pdf" /></label>
    <button type="submit">Enter bill</button>
  </form>
  <% } %>
</details>
<div class="toolbar"><% ['open','paid','void'].forEach(function(s) { %><a class="btn <%= status === s ? '' : 'btn-secondary' %>" href="/bills?status=<%= s %>"><%= fmt.label(s) %></a><% }); %></div>
<% if (!rows.length) { %><p class="empty">No bills.</p><% } else { %>
<table class="data-table">
  <thead><tr><th>Vendor</th><th>Bill #</th><th>PO</th><th>Date</th><th>Due</th><th class="num">Total</th><th class="num">Balance</th><th>Status</th></tr></thead>
  <tbody><% rows.forEach(function(b) { var late = ['open','partial'].includes(b.status) && b.due_date < today; %><tr><td><%= b.vendorName %></td><td><a href="/bills/<%= b.id %>"><%= b.bill_number || '#' + b.id %></a></td><td><% if (b.po_id) { %><a href="/purchasing/<%= b.po_id %>"><%= b.po_number %></a><% } %></td><td><%= fmt.d(b.bill_date) %></td><td class="<%= late ? 'priority-emergency' : '' %>"><%= fmt.d(b.due_date) %></td><td class="num"><%= fmt.money(b.total_cents) %></td><td class="num"><%= fmt.money(b.total_cents - b.amount_paid_cents) %></td><td><span class="status status-<%= b.status === 'open' ? 'issued' : b.status %>"><%= b.status %></span></td></tr><% }); %></tbody>
</table>
<% } %>
<%- include('partials/page-end') %>
