<%- include('partials/page-start') %>
<div class="page-header"><div><h1>Maintenance Agreements</h1><p class="hint">Start an agreement from a customer's page. Visits coming due become maintenance jobs automatically (if enabled in Settings) or with one click.</p></div></div>
<div class="stat-grid">
  <div class="stat"><div class="stat-label">Active agreements</div><div class="stat-value"><%= stats.active %></div></div>
  <div class="stat good"><div class="stat-label">Contract value (active)</div><div class="stat-value"><%= fmt.money(stats.annualValue) %></div></div>
  <div class="stat warn"><div class="stat-label">Visits due in 30 days</div><div class="stat-value"><%= stats.dueSoon %></div></div>
  <div class="stat warn"><div class="stat-label">Ending in 30 days</div><div class="stat-value"><%= stats.ending %></div></div>
</div>
<div class="toolbar"><% ['active','expired','renewed','cancelled'].forEach(function(s) { %><a class="btn <%= status === s ? '' : 'btn-secondary' %>" href="/agreements?status=<%= s %>"><%= fmt.label(s) %></a><% }); %></div>
<% if (!rows.length) { %><p class="empty">No <%= status %> agreements.</p><% } else { %>
<table class="data-table"><thead><tr><th>Agreement</th><th>Customer</th><th>Plan</th><th>Term</th><th>Next visit</th><th class="num">Price</th><th>Renews</th></tr></thead><tbody>
  <% rows.forEach(function(a) { %><tr><td><a href="/agreements/<%= a.id %>"><%= a.agreement_number %></a></td><td><a href="/customers/<%= a.customer_id %>"><%= a.customerName %></a><br><span class="hint"><%= a.address || '' %></span></td><td><%= a.name %></td><td class="small"><%= a.start_date %> to <span class="<%= a.status === 'active' && a.end_date < fmt.addDays(today, 30) ? 'priority-high' : '' %>"><%= a.end_date %></span></td><td class="<%= a.nextVisit && a.nextVisit < today ? 'priority-emergency' : '' %>"><%= a.nextVisit || '-' %></td><td class="num"><%= fmt.money(a.price_cents) %></td><td><%= a.auto_renew ? 'auto' : 'manual' %></td></tr><% }); %>
</tbody></table>
<% } %>
<h2 class="mt" id="plans">Plans</h2>
<% plans.forEach(function(p) { %>
  <details class="card" style="margin-bottom:0.5rem;"><summary><strong><%= p.name %></strong> <span class="hint"><%= p.visits_per_year %> visits/yr · <%= p.term_months %> months · <%= fmt.money(p.price_cents) %></span><% if (!p.active) { %> <span class="status status-cancelled">inactive</span><% } %></summary>
    <% if (can('agreements.manage')) { %><form method="POST" action="/agreements/plans" class="form-grid mt"><input type="hidden" name="id" value="<%= p.id %>" /><%- include('partials/plan-fields', { p: p }) %>
      <label>Status <select name="active"><option value="1" <%= p.active ? 'selected' : '' %>>Offered</option><option value="0" <%= !p.active ? 'selected' : '' %>>Retired</option></select></label>
      <div class="full"><button class="btn-secondary" type="submit">Save plan</button></div></form><% } else { %><p class="small" style="white-space:pre-wrap;"><%= p.included_services || '' %></p><% } %>
  </details>
<% }); %>
<% if (can('agreements.manage')) { %><details class="card"><summary><strong>+ New plan</strong></summary>
  <form method="POST" action="/agreements/plans" class="form-grid mt"><%- include('partials/plan-fields', { p: { visits_per_year: 2, term_months: 12 } }) %><div class="full"><button type="submit">Create plan</button></div></form>
</details><% } %>
<%- include('partials/page-end') %>
