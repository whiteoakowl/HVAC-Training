<%- include('partials/page-start') %>
<div class="page-header">
  <div><h1>Timesheets</h1><p class="hint">Week of <%= fmt.d(start) %> · overtime over <%= threshold %> h/week · times in <%= fmt.timezone() %></p></div>
  <div class="btn-row">
    <a class="btn btn-secondary" href="/manage/timesheets?week=<%= prev %>">&larr; Prev</a><a class="btn btn-secondary" href="/manage/timesheets">This week</a><a class="btn btn-secondary" href="/manage/timesheets?week=<%= next %>">Next &rarr;</a>
    <a class="btn btn-secondary" href="/manage/timesheets?week=<%= start %>&format=csv">Payroll export (CSV)</a>
  </div>
</div>
<% if (corrections.length) { %>
  <div class="card" style="margin-bottom:1rem;">
    <h2>Correction requests</h2>
    <% corrections.forEach(function(c) { %>
      <div style="border-top:1px solid var(--border); padding:0.4rem 0;">
        <strong><%= c.memberName %></strong>: <%= fmt.dt(c.clock_in) %> - <%= fmt.dt(c.clock_out) || 'open' %> → <%= fmt.dt(c.requested_clock_in) || '(same)' %> - <%= fmt.dt(c.requested_clock_out) || '(same)' %><br><span class="hint"><%= c.reason %></span>
        <form method="POST" action="/manage/timesheets/corrections/<%= c.id %>" class="inline-form"><button name="decision" value="approve" class="small">Approve</button> <button name="decision" value="reject" class="btn-danger small">Reject</button></form>
      </div>
    <% }); %>
  </div>
<% } %>
<% if (!people.length) { %><p class="empty">No time recorded this week.</p><% } %>
<form method="POST" action="/manage/timesheets/decide">
  <input type="hidden" name="week" value="<%= start %>" />
  <% people.forEach(function(p) { %>
    <div class="card" style="margin-bottom:0.75rem;">
      <div class="grid-box-header"><h2 style="margin:0;"><%= p.name %></h2><span><strong><%= fmt.hours(p.total) %> h</strong> · regular <%= fmt.hours(p.regular) %> · <span class="<%= p.overtime ? 'priority-high' : '' %>">OT <%= fmt.hours(p.overtime) %></span></span></div>
      <table class="data-table">
        <thead><tr><th></th><th>Date</th><th>In</th><th>Out</th><th>Break</th><th class="num">Hours</th><th>Job</th><th>GPS</th><th>Status</th></tr></thead>
        <tbody>
          <% p.entries.forEach(function(e) { %>
            <tr>
              <td><% if (e.status === 'pending' && e.member_id !== member.id) { %><input type="checkbox" name="entry_ids" value="<%= e.id %>" checked style="width:auto;" /><% } %></td>
              <td><%= fmt.d(e.clock_in) %></td><td><%= fmt.time(e.clock_in) %></td><td><%= e.clock_out ? fmt.time(e.clock_out) : 'open' %></td>
              <td><%= e.breakMinutes %>m</td><td class="num"><%= fmt.hours(e.workedMinutes) %></td><td><%= e.job_number || '' %></td>
              <td class="small"><% if (e.in_lat !== null && e.in_lat !== undefined) { %><a target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=<%= e.in_lat %>,<%= e.in_lng %>">in</a><% } %> <% if (e.out_lat !== null && e.out_lat !== undefined) { %><a target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=<%= e.out_lat %>,<%= e.out_lng %>">out</a><% } %></td>
              <td><span class="status status-<%= e.status %>"><%= e.status %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% }); %>
  <% if (people.some(function(p) { return p.pending; })) { %>
    <div class="btn-row"><button type="submit" name="decision" value="approved" class="btn-success">Approve selected</button><button type="submit" name="decision" value="rejected" class="btn-danger">Reject selected</button></div>
    <p class="hint">You can't approve your own time.</p>
  <% } %>
</form>
<%- include('partials/page-end') %>
