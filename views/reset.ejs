<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title }) %></head>
<body>
  <div class="auth-page"><div class="auth-card">
    <h1>Set a new password</h1>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="/reset/<%= token %>" class="stack-form">
      <label>New password <input type="password" name="password" minlength="10" autocomplete="new-password" required /></label>
      <label>Confirm <input type="password" name="confirm" minlength="10" autocomplete="new-password" required /></label>
      <button type="submit" class="primary-btn">Save password</button>
    </form>
  </div></div>
</body>
</html>
