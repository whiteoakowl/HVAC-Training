<%- include('partials/page-start') %>
<h1>Time Clock</h1>
<div class="card">
  <%- include('partials/clock-buttons', { entry: entry, onBreak: onBreak, back: '', myJobs: myJobs, gps: gps }) %>
</div>

<div class="page-header mt">
  <h2 style="margin:0;">Week of <%= week.start %></h2>
  <div class="btn-row"><a class="btn btn-secondary" href="/employee/time?week=<%= prevWeek %>">&larr; Prev</a><a class="btn btn-secondary" href="/employee/time">This week</a><a class="btn btn-secondary" href="/employee/time?week=<%= nextWeek %>">Next &rarr;</a></div>
</div>
<div class="stat-grid">
  <div class="stat"><div class="stat-label">Total</div><div class="stat-value"><%= fmt.hours(week.totalMinutes) %> h</div></div>
  <div class="stat"><div class="stat-label">Regular</div><div class="stat-value"><%= fmt.hours(week.regularMinutes) %> h</div></div>
  <div class="stat <%= week.overtimeMinutes ? 'warn' : '' %>"><div class="stat-label">Overtime (over <%= threshold %> h)</div><div class="stat-value"><%= fmt.hours(week.overtimeMinutes) %> h</div></div>
</div>
<% if (!week.entries.length) { %><p class="empty">No time this week.</p><% } else { %>
<table class="data-table">
  <thead><tr><th>Date</th><th>In</th><th>Out</th><th>Break</th><th class="num">Hours</th><th>Job</th><th>Status</th><th></th></tr></thead>
  <tbody>
    <% week.entries.forEach(function(e) { %>
      <tr>
        <td><%= e.clock_in.slice(0,10) %></td><td><%= e.clock_in.slice(11,16) %></td><td><%= e.clock_out ? e.clock_out.slice(11,16) : '-' %></td>
        <td><%= e.breakMinutes %> min</td><td class="num"><%= fmt.hours(e.workedMinutes) %></td>
        <td><%= e.job_number || '' %></td><td><span class="status status-<%= e.status %>"><%= e.status %></span></td>
        <td><% if (e.clock_out) { %>
          <details><summary class="small">Request correction</summary>
            <form method="POST" action="/employee/time/<%= e.id %>/correction" class="stack-form" style="min-width:240px;">
              <label>Correct clock-in <input type="datetime-local" name="clock_in" value="<%= fmt.toLocalInput(e.clock_in) %>" /></label>
              <label>Correct clock-out <input type="datetime-local" name="clock_out" value="<%= fmt.toLocalInput(e.clock_out) %>" /></label>
              <label>Reason <input name="reason" required /></label>
              <button type="submit" class="btn-secondary">Send</button>
            </form>
          </details>
        <% } %></td>
      </tr>
    <% }); %>
  </tbody>
</table>
<% } %>
<p class="hint">Times are <%= fmt.timezone() %>. Approved entries can't be edited - request a correction instead and a manager will review it.</p>
<% if (corrections.length) { %>
  <h2 class="mt">My correction requests</h2>
  <% corrections.forEach(function(c) { %><p class="small"><%= fmt.shortDateTime(c.created_at) %> · <%= c.reason %> · <span class="status status-<%= c.status %>"><%= c.status %></span></p><% }); %>
<% } %>
<%- include('partials/page-end') %>
