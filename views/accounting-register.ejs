<%- include('partials/page-start') %>
<div class="page-header">
  <div><h1><%= reg.account.code %> <%= reg.account.name %></h1><p class="hint">Account register · <%= fmt.label(reg.account.type) %><%= reg.account.subtype ? ' · ' + fmt.label(reg.account.subtype) : '' %> · <a href="/accounting/accounts">&larr; Chart of accounts</a></p></div>
  <div class="btn-row no-print"><a class="btn btn-secondary" href="?from=<%= from %>&to=<%= to %>&format=csv">Export CSV</a><button type="button" class="btn-secondary" onclick="window.print()">Print</button><% if (['bank','credit_card'].includes(reg.account.subtype)) { %><a class="btn btn-secondary" href="/accounting/banking/<%= reg.account.id %>">Banking</a><% } %></div>
</div>
<form class="toolbar no-print" method="GET"><label>From <input type="date" name="from" value="<%= from %>" /></label><label>To <input type="date" name="to" value="<%= to %>" /></label><button type="submit">Show</button></form>
<table class="data-table">
  <thead><tr><th>Date</th><th>Description</th><th>Account</th><th class="num">Increase</th><th class="num">Decrease</th><th class="num">Balance</th><th title="Reconciled">R</th></tr></thead>
  <tbody>
    <tr><td><%= fmt.d(from) %></td><td colspan="4"><em>Beginning balance</em></td><td class="num"><%= fmt.money(reg.opening) %></td><td></td></tr>
    <% reg.rows.forEach(function(r) { %>
      <tr><td><%= fmt.d(r.entry_date) %></td><td><a href="/accounting/journal/<%= r.entry_id %>"><%= fmt.usText(r.memo) %></a></td><td class="small"><%= r.split %></td>
        <td class="num"><%= r.change > 0 ? fmt.money(r.change) : '' %></td><td class="num"><%= r.change < 0 ? fmt.money(-r.change) : '' %></td><td class="num"><%= fmt.money(r.balance) %></td><td><%= r.reconciliation_id ? '✔' : '' %></td></tr>
    <% }); %>
    <tr class="total"><td colspan="5">Ending balance</td><td class="num"><%= fmt.money(reg.closing) %></td><td></td></tr>
  </tbody>
</table>
<%- include('partials/page-end') %>
