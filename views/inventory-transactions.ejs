<%- include('partials/page-start') %>
<div class="page-header"><h1>Inventory History</h1><div class="btn-row"><a class="btn btn-secondary" href="/inventory/transactions?format=csv">Export CSV</a><a class="btn btn-secondary" href="/inventory">&larr; Inventory</a></div></div>
<% if (!rows.length) { %><p class="empty">No inventory movements yet.</p><% } else { %>
<table class="data-table"><thead><tr><th>When</th><th>Item</th><th>Location</th><th>Kind</th><th class="num">Change</th><th class="num">Unit cost</th><th>Job</th><th>By</th><th>Note</th></tr></thead><tbody>
  <% rows.forEach(function(t) { %><tr><td class="small"><%= fmt.shortDateTime(t.created_at) %></td><td><a href="/inventory/items/<%= t.item_id %>"><%= t.itemName %></a></td><td><%= t.locationName %></td><td><%= fmt.label(t.kind) %></td><td class="num"><%= t.quantity_change > 0 ? '+' : '' %><%= Number(t.quantity_change) %></td><td class="num"><%= fmt.money(t.unit_cost_cents) %></td><td><% if (t.job_id) { %><a href="/jobs/<%= t.job_id %>"><%= t.job_number %></a><% } %></td><td class="small"><%= t.memberName || '' %></td><td class="small"><%= t.note || '' %></td></tr><% }); %>
</tbody></table>
<% } %>
<%- include('partials/page-end') %>
