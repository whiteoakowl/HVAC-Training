<%- include('partials/page-start') %>
<h1><%= loc.name %></h1>
<p class="hint"><%= loc.kind === 'truck' ? 'Truck inventory' : 'Warehouse' %> · value <%= fmt.money(value) %> · <a href="/inventory">&larr; Inventory</a></p>
<% if (!stock.length) { %><p class="empty">No stock here.</p><% } else { %>
<table class="data-table"><thead><tr><th>Item</th><th>SKU</th><th class="num">On hand</th><th class="num">Minimum</th><th>Bin</th><th class="num">Value</th></tr></thead><tbody>
  <% stock.forEach(function(s) { %><tr><td><a href="/inventory/items/<%= s.item_id %>"><%= s.name %></a></td><td><%= s.sku %></td><td class="num <%= s.min_quantity > 0 && s.quantity <= s.min_quantity ? 'priority-emergency' : '' %>"><%= Number(s.quantity) %> <%= s.unit %></td><td class="num"><%= Number(s.min_quantity) || '' %></td><td><%= s.bin || '' %></td><td class="num"><%= fmt.money(s.quantity * s.unit_cost_cents) %></td></tr><% }); %>
</tbody></table>
<% } %>
<h2 class="mt">Recent movements</h2>
<% history.forEach(function(t) { %><p class="small" style="margin:0.2rem 0;"><%= fmt.dt(t.created_at) %> · <%= fmt.label(t.kind) %> · <%= t.itemName %> <%= t.quantity_change > 0 ? '+' : '' %><%= Number(t.quantity_change) %><%= t.job_number ? ' · ' + t.job_number : '' %><%= t.memberName ? ' · ' + t.memberName : '' %></p><% }); %>
<%- include('partials/page-end') %>
