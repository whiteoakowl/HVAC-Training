<%- include('partials/page-start') %>
<h1>Welcome, <%= c.name.split(' ')[0] %></h1>
<p class="hint">Account <%= c.customer_number %> · <%= company.company_name || '' %><%= company.company_phone ? ' · ' + company.company_phone : '' %></p>
<% var openInv = invoices.filter(function(i) { return ['issued','partial'].includes(i.status); }); var pendingEst = estimates.filter(function(e) { return e.status === 'sent'; }); %>
<% if (pendingEst.length) { %><div class="alert alert-success">You have <%= pendingEst.length %> estimate(s) waiting for your approval below.</div><% } %>
<div class="two-col">
  <div class="stack">
    <div class="card">
      <h2>Request service</h2>
      <form method="POST" action="/my/request" class="form-grid">
        <label>Type <select name="kind"><% kinds.forEach(function(k) { %><option value="<%= k %>"><%= fmt.label(k) %></option><% }); %></select></label>
        <label>Address <select name="property_id"><% properties.forEach(function(p) { %><option value="<%= p.id %>"><%= p.address %></option><% }); %><option value="">Another address (type below)</option></select></label>
        <label class="full">New address (if not listed) <input name="address" /></label>
        <label>Preferred date <input type="date" name="preferred_date" /></label>
        <label>Preferred time <select name="preferred_time"><option value="">Any</option><option>Morning</option><option>Afternoon</option></select></label>
        <label class="full">What's going on? <textarea name="description" required></textarea></label>
        <div class="full"><button type="submit">Send request</button> <span class="hint">No heat or cooling in extreme weather? Call <%= company.company_phone || 'us' %> now.</span></div>
      </form>
    </div>
    <div class="card"><h2>Appointments &amp; service history</h2>
      <% if (!jobs.length) { %><p class="empty">No service yet.</p><% } %>
      <% jobs.forEach(function(j) { %><div style="border-top:1px solid var(--border); padding:0.4rem 0;"><strong><%= j.title %></strong> <span class="status status-<%= j.status %>"><%= fmt.label(j.status) %></span><br>
        <span class="hint"><%= j.completed_at ? 'Completed ' + fmt.d(j.completed_at) : j.scheduled_start ? 'Scheduled ' + fmt.dt(j.scheduled_start) : 'Being scheduled' %> · <%= j.job_number %></span>
        <% if (j.work_performed) { %><p class="small" style="white-space:pre-wrap; margin:0.2rem 0;"><%= j.work_performed %></p><% } %></div><% }); %>
    </div>
  </div>
  <div class="stack">
    <div class="card"><h2>Invoices</h2>
      <% if (!invoices.length) { %><p class="empty">None.</p><% } %>
      <% invoices.forEach(function(i) { %><p style="margin:0.3rem 0;"><a href="/i/<%= i.public_token %>"><%= i.invoice_number %></a> <%= fmt.money(i.total_cents) %> <span class="status status-<%= i.status %>"><%= i.status === 'issued' ? 'due ' + fmt.d(i.due_date) : i.status %></span><% if (['issued','partial'].includes(i.status)) { %> <span class="hint">balance <%= fmt.money(i.total_cents - i.amount_paid_cents - i.credited_cents) %></span><% } %></p><% }); %>
      <% if (openInv.length && company.invoice_payment_instructions) { %><p class="small"><strong>How to pay:</strong> <%= company.invoice_payment_instructions %></p><% } %>
    </div>
    <div class="card"><h2>Estimates</h2>
      <% if (!estimates.length) { %><p class="empty">None.</p><% } %>
      <% estimates.forEach(function(e) { %><p style="margin:0.3rem 0;"><a href="/e/<%= e.public_token %>"><%= e.estimate_number %></a> <%= e.title %> · <%= fmt.money(e.total_cents) %> <span class="status status-<%= e.status === 'sent' ? 'pending' : e.status === 'converted' ? 'approved' : e.status %>"><%= e.status === 'sent' ? 'awaiting your approval' : e.status %></span></p><% }); %>
    </div>
    <div class="card"><h2>Maintenance plan</h2>
      <% if (!agreements.length) { %><p class="empty">No active plan. Ask us about maintenance plans.</p><% } %>
      <% agreements.forEach(function(a) { %><p><strong><%= a.name %></strong><br><span class="hint">through <%= fmt.d(a.end_date) %><%= a.nextVisit ? ' · next visit ' + fmt.d(a.nextVisit) : '' %></span></p><% }); %>
    </div>
    <div class="card"><h2>My equipment</h2>
      <% if (!equipment.length) { %><p class="empty">None on file.</p><% } %>
      <% equipment.forEach(function(e) { %><p class="small" style="margin:0.25rem 0;"><strong><%= e.equipment_type %></strong> <%= [e.manufacturer, e.model_number].filter(Boolean).join(' ') %><br><span class="hint"><%= e.filter_size ? 'Filter ' + e.filter_size + ' · ' : '' %><%= e.warranty_expires ? 'Warranty to ' + fmt.d(e.warranty_expires) : '' %></span></p><% }); %>
    </div>
    <div class="card"><h2>Recent requests</h2><% requests.slice(0, 5).forEach(function(r) { %><p class="small" style="margin:0.2rem 0;"><%= r.request_number %> · <%= fmt.label(r.kind) %> · <%= r.status %></p><% }); %><% if (!requests.length) { %><p class="empty">None.</p><% } %></div>
  </div>
</div>
<%- include('partials/page-end') %>
