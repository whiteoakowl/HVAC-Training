<%
// Navigation is built from the signed-in member's permissions, grouped
// by portal: My Work (employee portal), Customer Service, Operations,
// Business (management portal), Team (the original training portal
// features) and Admin. A section only appears if the member can use at
// least one link in it, and every link points at a working page.
const sections = [];
function section(title, links) {
  const visible = links.filter(function(l) { return l.show; });
  if (visible.length) sections.push({ title: title, links: visible });
}
section(null, [
  { href: homeHref, icon: 'home', label: 'Home', show: true },
  { href: '/notifications', icon: 'bell', label: 'Notifications', badge: unreadNotifications, show: true },
  { href: '/messages', icon: 'users', label: 'Messages', show: can('messages.use') },
  { href: '/announcements', icon: 'clipboard', label: 'Announcements', show: can('portal.employee', 'portal.service', 'portal.management') },
  { href: '/account', icon: 'lock', label: 'My Account', show: true },
]);
section('My Work', [
  { href: '/employee', icon: 'clipboard', label: 'My Day', show: can('portal.employee') },
  { href: '/employee/jobs', icon: 'wrench', label: 'My Jobs', show: can('jobs.view_assigned', 'jobs.work') },
  { href: '/employee/time', icon: 'clock', label: 'Time Clock', show: can('timeclock.use') },
  { href: '/employee/truck', icon: 'truck', label: 'My Truck', show: can('inventory.use') },
  { href: '/employee/parts', icon: 'box', label: 'Parts Requests', show: can('inventory.use') },
  { href: '/employee/time-off', icon: 'calendar', label: 'Time Off', show: can('portal.employee') },
  { href: '/employee/pay', icon: 'dollar', label: 'Pay Stubs', show: can('portal.employee') },
  { href: '/employee/report', icon: 'file-text', label: 'End-of-Day Report', show: can('portal.employee') },
]);
section('Customer Service', [
  { href: '/service', icon: 'phone', label: 'Service Desk', show: can('portal.service') },
  { href: '/customers', icon: 'users', label: 'Customers', show: can('customers.view') },
  { href: '/requests', icon: 'clipboard', label: 'Service Requests', show: can('requests.view', 'requests.manage') },
  { href: '/estimates', icon: 'file-text', label: 'Estimates', show: can('estimates.view', 'estimates.manage') },
  { href: '/agreements', icon: 'shield', label: 'Maintenance Plans', show: can('agreements.manage') },
]);
section('Operations', [
  { href: '/jobs', icon: 'wrench', label: 'Jobs', show: can('jobs.view_all') },
  { href: '/dispatch', icon: 'calendar', label: 'Dispatch Board', show: can('jobs.dispatch', 'jobs.manage') },
  { href: '/inventory', icon: 'box', label: 'Inventory', show: can('inventory.view', 'inventory.manage') },
  { href: '/trucks', icon: 'truck', label: 'Trucks', show: can('trucks.manage', 'inventory.manage') },
  { href: '/inventory/parts-requests', icon: 'box', label: 'Parts Approvals', show: can('inventory.manage') },
  { href: '/purchasing', icon: 'box', label: 'Purchase Orders', show: can('purchasing.manage', 'purchasing.approve') },
  { href: '/vendors', icon: 'truck', label: 'Vendors', show: can('purchasing.manage', 'bills.manage') },
  { href: '/assets', icon: 'wrench', label: 'Tools & Equipment', show: can('assets.manage') },
]);
section('Business', [
  { href: '/manage', icon: 'chart', label: 'Dashboard', show: can('portal.management') },
  { href: '/invoices', icon: 'dollar', label: 'Invoices', show: can('invoices.view', 'invoices.manage') },
  { href: '/accounting', icon: 'dollar', label: 'Accounting', show: can('accounting.view') },
  { href: '/bills', icon: 'dollar', label: 'Vendor Bills', show: can('bills.manage') },
  { href: '/expenses', icon: 'dollar', label: 'Expenses', show: can('expenses.manage') },
  { href: '/payroll', icon: 'dollar', label: 'Payroll', show: can('payroll.view', 'payroll.manage') },
  { href: '/manage/reports', icon: 'chart', label: 'Reports', show: can('jobs.costing', 'accounting.view') },
  { href: '/manage/timesheets', icon: 'clock', label: 'Timesheets', show: can('timesheets.approve') },
  { href: '/manage/time-off', icon: 'calendar', label: 'Time-Off Approvals', show: can('timeoff.approve') },
  { href: '/manage/daily-reports', icon: 'file-text', label: 'End-of-Day Reports', show: can('dailyreports.view') },
  { href: '/manage/employees', icon: 'user', label: 'Employees', show: can('employees.view') },
  { href: '/training/center', icon: 'graduation-cap', label: 'Training Center', show: can('training.manage', 'employees.view') },
]);
section('Team', [
  { href: '/portal', icon: 'graduation-cap', label: 'Training Home', show: homeHref !== '/portal' && can('training.view') },
  { href: '/training/mine', icon: 'graduation-cap', label: 'Training', show: can('training.view') },
  { href: '/events', icon: 'calendar', label: 'Events', show: can('events.view', 'events.manage') },
  { href: '/forums', icon: 'users', label: 'Chat', show: can('forums.use', 'forums.moderate') },
  { href: '/documents', icon: 'file-text', label: 'Documents', show: can('documents.view', 'documents.manage') },
  { href: '/member-directory', icon: 'user', label: 'Directory', show: can('directory.view', 'directory.settings') },
]);
section('Admin', [
  { href: '/events/manage', icon: 'calendar', label: 'Manage Events', show: can('events.manage') },
  { href: '/training/manage', icon: 'graduation-cap', label: 'Manage Training', show: can('training.manage') },
  { href: '/documents/manage', icon: 'upload', label: 'Manage Documents', show: can('documents.manage') },
  { href: '/portal/members', icon: 'gear', label: 'Users & Roles', show: can('users.manage') },
  { href: '/admin/roles', icon: 'shield', label: 'Role Permissions', show: can('roles.manage') },
  { href: '/admin/settings', icon: 'gear', label: 'Company Settings', show: can('settings.manage') },
  { href: '/admin/audit', icon: 'shield', label: 'Audit & Automation', show: can('audit.view') },
  { href: '/admin/checklists', icon: 'clipboard', label: 'Checklists', show: can('checklists.manage') },
  { href: '/member-directory/settings', icon: 'gear', label: 'Directory Settings', show: can('directory.settings') },
]);
// Longest matching href wins, so /inventory/parts-requests highlights
// "Parts Approvals" rather than "Inventory".
const allHrefs = [];
sections.forEach(function(s) { s.links.forEach(function(l) { allHrefs.push(l.href); }); });
const activeHref = allHrefs
  .filter(function(h) { return currentPath === h || currentPath.indexOf(h + '/') === 0; })
  .sort(function(a, b) { return b.length - a.length; })[0];
%>
<%- include('icon-sprite') %>
<div class="app-shell">
  <%# On narrow screens the sidebar collapses into this top bar + a
      dropdown that starts closed on every page load. %>
  <header class="app-topbar">
    <a class="brand" href="<%= homeHref %>">HVAC Pro</a>
    <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="app-sidebar">
      <span class="menu-toggle-bars" aria-hidden="true"></span> Menu<% if (unreadNotifications) { %> <span class="badge-count"><%= unreadNotifications %></span><% } %>
    </button>
  </header>
  <aside class="app-sidebar" id="app-sidebar">
    <a class="brand sidebar-brand" href="<%= homeHref %>">HVAC Pro</a>
    <p class="sidebar-role">Signed in as <strong><%= member.name %></strong> &middot; <%= fmt.label(member.role) %></p>
    <% sections.forEach(function(s) { %>
      <% if (s.title) { %><p class="sidebar-section-title"><%= s.title %></p><% } %>
      <nav>
        <% s.links.forEach(function(link) { %>
          <a href="<%= link.href %>"<%- link.href === activeHref ? ' class="active" aria-current="page"' : '' %>><svg class="icon"><use href="#icon-<%= link.icon %>"/></svg> <%= link.label %><% if (link.badge) { %> <span class="badge-count"><%= link.badge %></span><% } %></a>
        <% }); %>
      </nav>
    <% }); %>
    <div class="sidebar-bottom">
      <form method="POST" action="/logout">
        <button type="submit"><svg class="icon"><use href="#icon-log-out"/></svg> Log out</button>
      </form>
    </div>
  </aside>
  <script>
    (function () {
      var toggle = document.querySelector('.menu-toggle');
      var sidebar = document.getElementById('app-sidebar');
      function setOpen(open) {
        sidebar.classList.toggle('open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      }
      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        setOpen(!sidebar.classList.contains('open'));
      });
      document.addEventListener('click', function (e) {
        if (sidebar.classList.contains('open') && !sidebar.contains(e.target)) setOpen(false);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') setOpen(false);
      });
      // Closes it when coming back via the browser's back button too.
      window.addEventListener('pageshow', function () { setOpen(false); });
    })();
  </script>
  <main class="app-main">
