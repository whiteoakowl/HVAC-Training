<%- include('partials/page-start') %>
<h1>Time Off</h1>
<div class="stat-grid">
  <div class="stat"><div class="stat-label">PTO / vacation balance</div><div class="stat-value"><%= Number(profile.pto_balance_hours) %> h</div></div>
  <div class="stat"><div class="stat-label">Sick leave balance</div><div class="stat-value"><%= Number(profile.sick_balance_hours) %> h</div></div>
</div>
<form method="POST" action="/employee/time-off" class="form-grid card">
  <label>Type <select name="kind"><% kinds.forEach(function(k) { %><option value="<%= k %>"><%= fmt.label(k) %></option><% }); %></select></label>
  <label>Hours (blank = <%= hoursPerDay %> per day) <input name="hours" inputmode="decimal" /></label>
  <label>First day <input type="date" name="start_date" required /></label>
  <label>Last day <input type="date" name="end_date" /></label>
  <label class="full">Note <input name="reason" /></label>
  <div class="full"><button type="submit">Request time off</button></div>
</form>
<h2 class="mt">My requests</h2>
<% if (!rows.length) { %><p class="empty">None yet.</p><% } else { %>
<table class="data-table"><thead><tr><th>Dates</th><th>Type</th><th class="num">Hours</th><th>Status</th><th></th></tr></thead><tbody>
  <% rows.forEach(function(r) { %><tr><td><%= r.start_date %><%= r.end_date !== r.start_date ? ' to ' + r.end_date : '' %></td><td><%= fmt.label(r.kind) %></td><td class="num"><%= Number(r.hours) %></td>
    <td><span class="status status-<%= r.status === 'denied' ? 'rejected' : r.status === 'cancelled' ? 'cancelled' : r.status %>"><%= r.status %></span><%= r.decision_note ? ' · ' + r.decision_note : '' %></td>
    <td><% if (['pending','approved'].includes(r.status) && r.start_date > fmt.today()) { %><form method="POST" action="/employee/time-off/<%= r.id %>/cancel" class="inline-form"><button class="btn-secondary small" type="submit">Cancel</button></form><% } %></td></tr><% }); %>
</tbody></table>
<% } %>
<%- include('partials/page-end') %>
