<!doctype html>
<html lang="en">
<head><%- include('partials/head', { title }) %></head>
<body>
  <div class="auth-page"><div class="auth-card">
    <h1>Two-step verification</h1>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="/login/mfa" class="stack-form">
      <label>6-digit code from your authenticator app <input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="\d{6}" maxlength="6" required autofocus /></label>
      <button type="submit" class="primary-btn">Verify</button>
    </form>
    <p class="hint">Lost your phone? Ask an administrator to reset two-step verification on your account.</p>
  </div></div>
</body>
</html>
